    "What's on your mind? Ideas, problems and questions are all welcome.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was möchtest du uns sagen? Ideen, Probleme und Fragen sind alle willkommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quieres contarnos? Ideas, problemas y preguntas son bienvenidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'avez-vous à nous dire ? Idées, problèmes et questions sont les bienvenus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang ingin kamu sampaikan? Ide, masalah, dan pertanyaan semuanya diterima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vuoi dirci? Idee, problemi e domande sono tutti benvenuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご意見をお聞かせください。アイデア、問題、質問など何でも歓迎です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 이야기든 들려주세요. 아이디어, 문제, 질문 모두 환영합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat wil je kwijt? Ideeën, problemen en vragen zijn allemaal welkom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co chcesz nam przekazać? Pomysły, problemy i pytania są mile widziane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você quer nos contar? Ideias, problemas e perguntas são bem-vindos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что хотите рассказать? Идеи, проблемы и вопросы — всё приветствуется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad vill du berätta? Idéer, problem och frågor är alla välkomna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากบอกอะไรเรา ไอเดีย ปัญหา หรือคำถาม ยินดีรับฟังทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aklında ne var? Fikirler, sorunlar ve sorular, hepsi memnuniyetle karşılanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn chia sẻ điều gì? Ý tưởng, vấn đề hay câu hỏi đều được hoan nghênh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想说点什么？欢迎提出想法、问题和疑问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想說些什麼？歡迎提出想法、問題和疑問。"
          }
        }
      }
    },
    "You've sent several messages in a row. Try again in a minute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast mehrere Nachrichten hintereinander gesendet. Versuche es in einer Minute erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has enviado varios mensajes seguidos. Vuelve a intentarlo dentro de un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez envoyé plusieurs messages d'affilée. Réessayez dans une minute."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah mengirim beberapa pesan berturut-turut. Coba lagi dalam satu menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai inviato diversi messaggi di fila. Riprova tra un minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けて複数のメッセージが送信されました。1分ほどしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 연속으로 여러 개 보냈습니다. 1분 후에 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt meerdere berichten achter elkaar verstuurd. Probeer het over een minuut opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłano kilka wiadomości z rzędu. Spróbuj ponownie za minutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você enviou várias mensagens seguidas. Tente novamente em um minuto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отправили несколько сообщений подряд. Повторите попытку через минуту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har skickat flera meddelanden i rad. Försök igen om en minut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณส่งข้อความหลายข้อความติดกัน ลองอีกครั้งในอีกหนึ่งนาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka arkaya birkaç mesaj gönderdin. Bir dakika sonra tekrar dene."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã gửi nhiều tin nhắn liên tiếp. Hãy thử lại sau một phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你连续发送了多条消息，请一分钟后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你連續傳送了多則訊息，請一分鐘後再試一次。"
          }
        }
      }
    },
    "Your app version, device model and system version are sent with your message.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deiner Nachricht werden App-Version, Gerätemodell und Systemversion gesendet."
          }
        },
        "es": {
